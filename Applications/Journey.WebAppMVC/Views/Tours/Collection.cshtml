@model Journey.WebAppMVC.Models.ToursCollectionViewModel

<div class="container mt-5">

    <h2 class="text-center mb-4">
        Список туров
    </h2>

    <div class="mt-3 p-3 border rounded bg-light">
        <div class="row text-center">

            <div class="col">
                <div><strong>Всего туров</strong></div>
                <div>@Model.Statistics.TotalTours</div>
            </div>

            <div class="col">
                <div><strong>Макс цена</strong></div>
                <div>@Model.Statistics.MaxTourPrice</div>
            </div>

            <div class="col">
                <div><strong>Доплата (%)</strong></div>
                <div>@Model.Statistics.AvgSurchargePercent.ToString("F2")</div>
            </div>

            <div class="col">
                <div><strong>Среднее туристов</strong></div>
                <div>@Model.Statistics.AvgVacationers.ToString("F2")</div>
            </div>

            <div class="col">
                <div><strong>Wi-Fi (%)</strong></div>
                <div>@Model.Statistics.WifiPercent.ToString("F2") %</div>
            </div>

            <div class="col">
                <div><strong>Средние ночи</strong></div>
                <div>@Model.Statistics.AvgNights.ToString("F2")</div>
            </div>

            <div class="col">
                <div><strong>Макс цена</strong></div>
                <div>@Model.Statistics.MaxTourPrice.ToString("F2") ₽</div>
            </div>

        </div>
    </div>

    <table class="table table-striped table-hover table-bordered align-middle">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Локация</th>
                <th>Ночей</th>
                <th>Дата вылета</th>
                <th>Цена за человека</th>
                <th>Кол-во отдыхающих</th>
                <th>Wi-Fi</th>
                <th>Доплата</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var tour in Model.Tours)
            {
                <tr>

                    <td>@tour.Id</td>

                    <td>
                        <a href="@Url.Action("Edit", "Tours", new { id = tour.Id })">@tour.Location</a>
                    </td>

                    <td>@tour.NightCount</td>

                    <td>
                        @tour.DepartureDate.ToString("dd.MM.yyyy")
                    </td>

                    <td>
                        @tour.CostPerVacationer ₽
                    </td>

                    <td>
                        @tour.VacationerCount
                    </td>

                    <td>
                        @(tour.WiFiAvailabble ? "Да" : "Нет")
                    </td>

                    <td>
                        @tour.Surcharge ₽
                    </td>
                </tr>
            }

        </tbody>

    </table>

    <nav class="mt-3">
        <ul class="pagination justify-content-center">

            @if (Model.Page > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Collection"
                           asp-route-page="@(Model.Page - 1)">
                        Назад
                    </a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">

                    <a class="page-link"
                           asp-action="Collection"
                           asp-route-page="@i">
                        @i
                    </a>

                </li>
            }

            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                           asp-action="Collection"
                           asp-route-page="@(Model.Page + 1)">
                        Вперёд
                    </a>
                </li>
            }

        </ul>
    </nav>

</div>
